{
  "manifest_version": 3,
  "name": "TransVault · 双语翻译",
  "version": "0.1.0",
  "description": "沉浸式双语网页翻译：整页对照 / 划词翻译 / 多引擎分层回退（Google · 必应Azure · 阿里云 · 百度 · 腾讯云 · LLM）。",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "TransVault 双语翻译",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "commands": {
    "toggle-page-translate": {
      "suggested_key": { "default": "Alt+A" },
      "description": "开启/关闭当前页面双语翻译"
    }
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": [
        "shared/config.js",
        "shared/util.js",
        "shared/storage.js",
        "shared/dynamic-core.js",
        "content/site-adapters.js",
        "adapters/index.js",
        "wall/detector.js",
        "wall/strategies/paywall.js",
        "content/page-translator.js",
        "content/ui.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "permissions": ["storage", "unlimitedStorage", "contextMenus"],
  "host_permissions": [
    "https://translate.googleapis.com/*",
    "https://lingva.ml/*",
    "https://lingva.lunar.icu/*",
    "https://translate.plausibility.cloud/*",
    "http://localhost/*",
    "http://127.0.0.1/*",
    "https://api.cognitive.microsofttranslator.com/*",
    "https://api.translator.azure.cn/*",
    "https://mt.aliyuncs.com/*",
    "https://fanyi-api.baidu.com/*",
    "https://tmt.tencentcloudapi.com/*",
    "https://api.deepseek.com/*",
    "https://generativelanguage.googleapis.com/*"
  ],
  "optional_host_permissions": ["https://*/*", "http://*/*"]
}